# =====================================================
# Rolling Commerce - Server Environment Variables
# =====================================================

# --- Server ---
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# =====================================================
# Database
# =====================================================

MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-url>/<database>?retryWrites=true&w=majority

# =====================================================
# Authentication
# =====================================================

JWT_SECRET=replace_with_strong_secret

# =====================================================
# SMTP / Email
# =====================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<smtp-user@example.com>
SMTP_PASS=<smtp-password-or-app-password>
SMTP_FROM="Rolling Commerce <noreply@rolling-commerce.com>"

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=<email-user@example.com>
EMAIL_PASSWORD=<email-password-or-app-password>
EMAIL_FROM="Rolling Commerce <noreply@rolling-commerce.com>"
EMAIL_ADDRESS=<test-recipient@example.com>

# =====================================================
# Cloudinary
# =====================================================

# Backend only. Never expose CLOUDINARY_API_SECRET.

CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# =====================================================
# Mercado Pago
# =====================================================

# Backend only. Never expose this token.

MERCADOPAGO_ACCESS_TOKEN=<mercadopago-access-token>

# =====================================================
# Frontend
# =====================================================

# Used inside client/.env

VITE_API_URL=http://localhost:3000/api
